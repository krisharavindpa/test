//8a fcfs

#include <stdio.h>

int main() {
    int n, bt[20], wt[20], tat[20];
    float total_wt = 0, total_tat = 0;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    printf("Enter Burst Time for each process:\n");
    for(int i = 0; i < n; i++) {
        printf("Process %d: ", i + 1);
        scanf("%d", &bt[i]);
    }

    wt[0] = 0; // First process waiting time is 0

    // Calculate waiting time
    for(int i = 1; i < n; i++) {
        wt[i] = bt[i-1] + wt[i-1];
    }

    printf("\nProcess\t Burst Time\t Waiting Time\t Turnaround Time\n");

    // Calculate Turnaround time and totals
    for(int i = 0; i < n; i++) {
        tat[i] = bt[i] + wt[i];
        total_wt += wt[i];
        total_tat += tat[i];
        printf("P%d\t %d\t\t %d\t\t %d\n", i + 1, bt[i], wt[i], tat[i]);
    }

    printf("\nAverage Waiting Time: %.2f\n", total_wt / n);
    printf("Average Turnaround Time: %.2f\n", total_tat / n);

    return 0;
}

// 8b sjf

#include <stdio.h>

int main() {
    int n, bt[20], wt[20], tat[20], p[20];
    float total_wt = 0, total_tat = 0;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    printf("Enter Burst Time for each process:\n");
    for(int i = 0; i < n; i++) {
        printf("Process %d: ", i + 1);
        scanf("%d", &bt[i]);
        p[i] = i + 1; // Assign process IDs
    }

    // Sort processes by burst time (Selection Sort)
    for(int i = 0; i < n - 1; i++) {
        for(int j = i + 1; j < n; j++) {
            if(bt[i] > bt[j]) {
                // Swap Burst Time
                int temp = bt[i];
                bt[i] = bt[j];
                bt[j] = temp;
                // Swap Process ID
                temp = p[i];
                p[i] = p[j];
                p[j] = temp;
            }
        }
    }

    wt[0] = 0; // First process waiting time is 0

    // Calculate waiting time
    for(int i = 1; i < n; i++) {
        wt[i] = bt[i-1] + wt[i-1];
    }

    printf("\nProcess\t Burst Time\t Waiting Time\t Turnaround Time\n");

    // Calculate Turnaround time and totals
    for(int i = 0; i < n; i++) {
        tat[i] = bt[i] + wt[i];
        total_wt += wt[i];
        total_tat += tat[i];
        printf("P%d\t %d\t\t %d\t\t %d\n", p[i], bt[i], wt[i], tat[i]);
    }

    printf("\nAverage Waiting Time: %.2f\n", total_wt / n);
    printf("Average Turnaround Time: %.2f\n", total_tat / n);

    return 0;
}


//9 (banker algo)

#include <stdio.h>

int main() {
    int n, m, i, j, k;
    printf("Enter number of processes & resources: ");
    scanf("%d %d", &n, &m);
    
    int alloc[n][m], max[n][m], avail[m], need[n][m];
    
    printf("Enter Allocation Matrix:\n");
    for(i = 0; i < n; i++) for(j = 0; j < m; j++) scanf("%d", &alloc[i][j]);
        
    printf("Enter Max Matrix:\n");
    for(i = 0; i < n; i++) for(j = 0; j < m; j++) scanf("%d", &max[i][j]);
        
    printf("Enter Available Resources:\n");
    for(j = 0; j < m; j++) scanf("%d", &avail[j]);

    // Calculate Need Matrix
    for(i = 0; i < n; i++) 
        for(j = 0; j < m; j++) 
            need[i][j] = max[i][j] - alloc[i][j];

    int finish[n], safeSeq[n], ind = 0;
    for(i = 0; i < n; i++) finish[i] = 0;

    // Safety Algorithm
    for(k = 0; k < n; k++) {
        for(i = 0; i < n; i++) {
            if(finish[i] == 0) {
                int flag = 0;
                for(j = 0; j < m; j++) {
                    if(need[i][j] > avail[j]) { flag = 1; break; }
                }
                if(flag == 0) {
                    safeSeq[ind++] = i;
                    for(j = 0; j < m; j++) avail[j] += alloc[i][j];
                    finish[i] = 1;
                }
            }
        }
    }

    // Check Safe State
    int safe = 1;
    for(i = 0; i < n; i++) {
        if(finish[i] == 0) { safe = 0; break; }
    }

    if(safe) {
        printf("System is Safe.\nSafe Sequence: ");
        for(i = 0; i < n - 1; i++) printf("P%d -> ", safeSeq[i]);
        printf("P%d\n", safeSeq[n - 1]);
    } else {
        printf("System is Unsafe (Deadlock possible).\n");
    }

    return 0;
}



